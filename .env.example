# Copy to .env (or set these in your host's dashboard).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=philos.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://philos.example.com
SITE_URL=https://philos.example.com
DATABASE_URL=postgres://user:password@host:5432/philos
# Optional
DJANGO_HSTS_SECONDS=0
PLAUSIBLE_DOMAIN=
GA_MEASUREMENT_ID=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Philos <hello@philos.example.com>
